{
  "name": "k8s-rollout-stuck",
  "description": "Diagnose a stuck rollout after a bad deployment update",
  "scenarios": [
    {
      "name": "diagnose-stuck-rollout",
      "goal": {
        "description": "Identify why deployment/api rollout is stuck and determine the recovery action",
        "success_criteria": [
          {
            "key": "root_cause_identified",
            "expected": true
          },
          {
            "key": "recovery_action_determined",
            "expected": true
          }
        ]
      },
      "task": {
        "description": "Inspect deployment rollout status, pod states and events to determine why the rollout is stuck",
        "required_criteria": [
          "root_cause_identified"
        ]
      },
      "expectations": {
        "expected_status": "completed",
        "max_iterations": 8,
        "required_capabilities": [
          "inspect_workload",
          "inspect_pod",
          "inspect_events"
        ],
        "required_evidence_claims": [
          "root_cause",
          "healthy"
        ]
      },
      "kind": "scenario",
      "tags": [
        "kubernetes",
        "rollout",
        "diagnosis"
      ]
    }
  ],
  "quality_gate": {
    "min_pass_rate": 0.85,
    "min_goal_completion_rate": 0.9
  }
}