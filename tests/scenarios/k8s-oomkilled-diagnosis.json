        "required_evidence_claims": [
          "root_cause",
          "healthy"
        ],
        "forbidden_events": [
          "ActionReconcileRequired"
        ]
      },
      "kind": "scenario",
      "tags": [
        "kubernetes",
        "pod",
        "oom",
        "diagnosis"
      ]
    }
  ],
  "quality_gate": {
    "min_pass_rate": 0.85,
