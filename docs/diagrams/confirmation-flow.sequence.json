{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "人工确认时序（CONFIRM）",
    "locale": "zh-CN",
    "output": "confirmation-flow.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "views": [
      {
        "id": "policy-check",
        "label": "策略检查",
        "focus": [
          "kernel",
          "policy"
        ],
        "note": "决策提案先经确定性策略引擎，返回 ALLOW / CONFIRM / DENY。"
      },
      {
        "id": "human-in-loop",
        "label": "人工在环",
        "focus": [
          "kernel",
          "api"
        ],
        "note": "Runtime 暂停执行并经 Runtime API 请求用户批准。"
      },
      {
        "id": "branches",
        "label": "拒绝与拒绝分支",
        "focus": [
          "api",
          "kernel",
          "policy"
        ],
        "note": "用户拒绝取消动作；DENY 直接停止且不进入暂停。"
      }
    ],
    "viewBox": [
      1050,
      560
    ]
  },
  "participants": [
    {
      "id": "api",
      "type": "frontend",
      "label": "Runtime API",
      "sublabel": "agentd · 用户入口"
    },
    {
      "id": "kernel",
      "type": "backend",
      "label": "Agent Kernel",
      "sublabel": "生命周期 · 任务循环"
    },
    {
      "id": "policy",
      "type": "security",
      "label": "Policy Engine",
      "sublabel": "ALLOW / CONFIRM / DENY"
    },
    {
      "id": "action",
      "type": "backend",
      "label": "Action Runtime",
      "sublabel": "工具执行 · 超时 · 审计"
    }
  ],
  "messages": [
    {
      "id": "propose-decision",
      "from": "kernel",
      "to": "policy",
      "y": 162,
      "label": "决策提案",
      "variant": "default"
    },
    {
      "id": "policy-confirm",
      "from": "policy",
      "to": "kernel",
      "y": 202,
      "label": "CONFIRM · 需人工确认",
      "variant": "security"
    },
    {
      "id": "pause-request",
      "from": "kernel",
      "to": "api",
      "y": 244,
      "label": "暂停执行 · 请求确认",
      "variant": "emphasis",
      "note": "暂停是 Runtime 状态转换，模型不能自行恢复"
    },
    {
      "id": "user-approve",
      "from": "api",
      "to": "kernel",
      "y": 292,
      "label": "用户批准",
      "variant": "return"
    },
    {
      "id": "user-reject",
      "from": "api",
      "to": "kernel",
      "y": 330,
      "label": "用户拒绝 → 取消动作",
      "variant": "dashed",
      "note": "目标可转 Ask User 或 Finish，不执行该动作"
    },
    {
      "id": "dispatch-action",
      "from": "kernel",
      "to": "action",
      "y": 378,
      "label": "执行动作",
      "variant": "emphasis"
    },
    {
      "id": "action-result",
      "from": "action",
      "to": "kernel",
      "y": 416,
      "label": "观察结果",
      "variant": "return"
    },
    {
      "id": "policy-deny",
      "from": "policy",
      "to": "kernel",
      "y": 462,
      "label": "分支 DENY → 立即停止",
      "variant": "dashed",
      "note": "策略拒绝走确定性代码，不进入暂停等待"
    }
  ],
  "activations": [
    {
      "participant": "kernel",
      "from": 158,
      "to": 422,
      "type": "backend"
    },
    {
      "participant": "policy",
      "from": 160,
      "to": 228,
      "type": "security"
    },
    {
      "participant": "api",
      "from": 240,
      "to": 336,
      "type": "frontend"
    },
    {
      "participant": "action",
      "from": 374,
      "to": 422,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "确认主路径",
      "items": [
        "Policy 返回 CONFIRM 后 Runtime 暂停，模型不能自行恢复",
        "用户批准后动作才进入 Action Runtime，并产生观察结果"
      ]
    },
    {
      "dot": "rose",
      "title": "两条拒绝分支",
      "items": [
        "DENY 由确定性代码判定，直接停止且不暂停",
        "用户拒绝 → 取消动作，目标转 Ask User 或 Finish"
      ]
    }
  ]
}