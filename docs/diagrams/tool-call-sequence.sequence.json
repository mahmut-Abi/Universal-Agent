      "variant": "security"
    },
    {
      "id": "policy-allow",
      "from": "policy",
      "to": "kernel",
      "y": 292,
      "label": "ALLOW",
      "variant": "return"
    },
    {
      "id": "policy-deny",
      "from": "policy",
      "to": "kernel",
      "y": 336,
      "label": "DENY → 停止",
      "variant": "dashed",
      "note": "分支：策略拒绝时不执行任何工具"
    },
    {
      "id": "execute-capability",
      "from": "kernel",
      "to": "action",
      "y": 380,
      "label": "执行 capability 与参数",
