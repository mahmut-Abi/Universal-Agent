        "focus": [
          "kernel",
          "decision",
          "policy",
          "action",
          "evidence"
        ],
        "note": "决策提案经策略允许后执行工具，结果归一化为证据。"
      },
      {
        "id": "deny-branch",
        "label": "DENY 分支",
        "focus": [
          "kernel",
          "policy"
        ],
        "note": "策略拒绝时立即停止，不执行任何工具。"
      },
      {
        "id": "evidence-handoff",
        "label": "证据移交",
        "focus": [
          "action",
          "evidence",
          "kernel"
        ],
        "note": "工具成功不等于任务成功，证据必须经 Evaluator 验证。"
      }
    ]
  },
  "participants": [
    {
      "id": "kernel",
      "type": "backend",
      "label": "Agent Kernel",
      "sublabel": "任务循环编排"
    },
    {
      "id": "decision",
      "type": "backend",
      "label": "Decision Engine",
      "sublabel": "LLM 推理提案"
    },
    {
      "id": "policy",
      "type": "security",
      "label": "Policy Engine",
      "sublabel": "确定性规则"
    },
    {
      "id": "action",
      "type": "backend",
      "label": "Action Runtime",
      "sublabel": "工具执行 · 超时 · 取消"
    },
    {
      "id": "evidence",
      "type": "backend",
      "label": "Evidence System",
      "sublabel": "观察 → 证据"
    }
  ],
  "messages": [
