{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Goal / Task 状态机",
    "locale": "zh-CN",
    "output": "goal-task-lifecycle.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-path",
        "label": "主执行路径",
        "focus": ["created", "running", "evaluating", "completed"],
        "note": "每轮迭代后都经过评估，验证通过才算完成。"
      },
      {
        "id": "human-gates",
        "label": "暂停与人工确认",
        "focus": ["running", "waiting_confirmation", "paused"],
        "note": "CONFIRM 与人工 Pause 都是非终态等待。"
      },
      {
        "id": "recovery-exits",
        "label": "恢复与终态",
        "focus": ["running", "recovering", "failed", "cancelled"],
        "note": "可恢复错误经 Recovery 回到运行中；终态不再回流。"
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "主状态轨" },
    { "id": "waiting", "label": "等待 / 人工门" },
    { "id": "recovery", "label": "恢复回路" },
    { "id": "terminal", "label": "终态出口" }
  ],
  "states": [
    { "id": "created", "type": "start", "label": "已创建", "sublabel": "goal / task 建立", "lane": "main", "col": 0, "step": "01", "tag": "入口" },
    { "id": "running", "type": "active", "label": "运行中", "sublabel": "决策 · 动作 · 观察", "lane": "main", "col": 1, "step": "02", "tag": "执行循环" },
    { "id": "evaluating", "type": "decision", "label": "评估", "sublabel": "Evaluator 验证", "lane": "main", "col": 2, "step": "03", "tag": "验证门" },
    { "id": "completed", "type": "success", "label": "已完成", "sublabel": "验证通过", "lane": "main", "col": 3, "step": "04", "tag": "终态" },
    { "id": "waiting_confirmation", "type": "waiting", "label": "等待确认", "sublabel": "Policy → CONFIRM", "lane": "waiting", "col": 0, "tag": "人工门" },
    { "id": "paused", "type": "waiting", "label": "已暂停", "sublabel": "人工 Pause", "lane": "waiting", "col": 1, "tag": "可恢复" },
    { "id": "recovering", "type": "failure", "label": "恢复中", "sublabel": "Recovery Manager", "lane": "recovery", "col": 1, "tag": "可恢复错误" },
    { "id": "failed", "type": "failure", "label": "已失败", "sublabel": "不可恢复", "lane": "terminal", "col": 0, "tag": "终态" },
    { "id": "cancelled", "type": "failure", "label": "已取消", "sublabel": "用户停止", "lane": "terminal", "col": 1, "tag": "终态" }
  ],
  "transitions": [
    { "id": "created-to-running", "from": "created", "to": "running", "label": "开始执行" },
    { "id": "running-to-evaluating", "from": "running", "to": "evaluating", "label": "每轮迭代后" },
    { "id": "evaluating-to-running", "from": "evaluating", "to": "running", "label": "继续下一任务", "variant": "emphasis" },
    { "id": "evaluating-to-completed", "from": "evaluating", "to": "completed", "label": "验证通过" },
    { "id": "running-to-confirm", "from": "running", "to": "waiting_confirmation", "label": "Policy: CONFIRM", "variant": "security" },
    { "id": "confirm-to-running", "from": "waiting_confirmation", "to": "running", "label": "用户批准", "variant": "emphasis" },
    { "id": "confirm-to-cancelled", "from": "waiting_confirmation", "to": "cancelled", "label": "用户拒绝", "variant": "security" },
    { "id": "running-to-paused", "from": "running", "to": "paused", "label": "人工暂停" },
    { "id": "paused-to-running", "from": "paused", "to": "running", "label": "Resume", "variant": "emphasis" },
    { "id": "running-to-recovering", "from": "running", "to": "recovering", "label": "可恢复错误", "variant": "security" },
    { "id": "recovering-to-running", "from": "recovering", "to": "running", "label": "恢复成功", "variant": "emphasis" },
    { "id": "recovering-to-failed", "from": "recovering", "to": "failed", "label": "恢复失败" },
    { "id": "running-to-failed", "from": "running", "to": "failed", "label": "不可恢复错误", "variant": "security" },
    { "id": "running-to-cancelled", "from": "running", "to": "cancelled", "label": "随时 Cancel" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "created → running → evaluating → completed 是唯一主轨",
        "每轮迭代都经过评估，验证通过才进入终态",
        "工具成功 ≠ 任务成功，完成由 Evaluator 决定"
      ]
    },
    {
      "dot": "amber",
      "title": "暂停与人工门",
      "items": [
        "Policy 返回 CONFIRM 时暂停，等待人工批准",
        "人工 Pause 后可 Resume 回到运行中",
        "等待状态都是非终态，随时可能继续或取消"
      ]
    },
    {
      "dot": "rose",
      "title": "恢复与终态",
      "items": [
        "recovering 是可恢复状态，恢复成功回 running",
        "恢复失败或不可恢复错误进入 failed",
        "completed / failed / cancelled 是终态，不再回流"
      ]
    }
  ]
}
