{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Agent 核心执行循环",
    "locale": "zh-CN",
    "output": "agent-core-loop.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-loop",
        "label": "主循环",
        "focus": [
          "goal",
          "context",
          "decision",
          "policy",
          "action",
          "obs",
          "update",
          "evaluate",
          "finish"
        ],
        "note": "从目标到经验证的完成：决策、治理、执行、观察、评估一条主路径。"
      },
      {
        "id": "governance",
        "label": "治理与确认",
        "focus": [
          "decision",
          "policy",
          "ask",
          "action"
        ],
        "note": "策略在模型之外以确定性代码执行，DENY 与 CONFIRM 都不经过模型。"
      },
      {
        "id": "recovery-loop",
        "label": "恢复与迭代",
        "focus": [
          "evaluate",
          "recover",
          "cont",
          "action",
          "decision"
        ],
        "note": "评估驱动继续、恢复或询问；恢复回到执行，继续回到决策。"
      }
    ]
  },
  "lanes": [
    {
      "id": "kernel",
      "label": "内核循环"
    },
    {
      "id": "observe",
      "label": "观察 · 证据"
    },
    {
      "id": "state",
      "label": "状态与世界模型"
    },
    {
      "id": "eval",
      "label": "评估"
    },
    {
      "id": "outcomes",
      "label": "循环出口"
    }
  ],
  "phases": [
    {
      "id": "perceive",
      "label": "感知与编译",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "decide",
      "label": "决策与治理",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "act",
      "label": "执行与验证",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "goal",
    "context",
    "decision",
    "policy",
    "action",
    "obs",
    "update",
    "evaluate",
    "finish"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "goal"
    ],
    "allowedTerminals": [
      "cont",
      "recover",
      "ask",
      "finish"
    ],
    "requiredPaths": [
      {
        "from": "goal",
        "to": "finish"
      }
    ]
  },
  "nodes": [
    {
      "id": "goal",
      "lane": "kernel",
      "col": 0,
      "type": "external",
      "label": "Goal",
      "sublabel": "用户目标"
    },
    {
      "id": "context",
      "lane": "kernel",
      "col": 1,
      "type": "backend",
      "label": "Context Compilation",
      "sublabel": "状态 · 世界模型 · 当前任务",
      "width": 150
    },
    {
      "id": "decision",
      "lane": "kernel",
      "col": 2,
      "type": "backend",
      "label": "Decision",
      "sublabel": "结构化决策提案"
    },
    {
      "id": "policy",
      "lane": "kernel",
      "col": 3,
      "type": "security",
      "label": "Policy Check",
      "sublabel": "ALLOW / CONFIRM / DENY"
    },
    {
      "id": "action",
      "lane": "kernel",
      "col": 4,
      "type": "cloud",
      "label": "Action",
      "sublabel": "工具执行 · 超时可控"
    },
    {
      "id": "obs",
      "lane": "observe",
      "col": 5,
      "type": "messagebus",
      "label": "Observation · Evidence",
      "sublabel": "工具结果 → 规范化证据",
      "width": 170
    },
    {
      "id": "update",
      "lane": "state",
      "col": 5,
      "type": "database",
      "label": "State / World Update",
      "sublabel": "运行时持有，模型只读",
      "width": 150
    },
    {
      "id": "evaluate",
      "lane": "eval",
      "col": 5,
      "type": "backend",
      "label": "Evaluation",
      "sublabel": "验证任务 / 目标成功"
    },
    {
      "id": "cont",
      "lane": "outcomes",
      "col": 1,
      "type": "backend",
      "label": "Continue",
      "sublabel": "动态扩展下一任务"
    },
    {
      "id": "recover",
      "lane": "outcomes",
      "col": 2,
      "type": "security",
      "label": "Recover",
      "sublabel": "重试 / 替代能力"
    },
    {
      "id": "ask",
      "lane": "outcomes",
      "col": 3,
      "type": "external",
      "label": "Ask User",
      "sublabel": "等待人工输入"
    },
    {
      "id": "finish",
      "lane": "outcomes",
      "col": 5,
      "type": "cloud",
      "label": "Finish",
      "sublabel": "目标达成 · 已验证"
    }
  ],
  "edges": [
    {
      "id": "goal-context",
      "from": "goal",
      "to": "context",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "context-decision",
      "from": "context",
      "to": "decision",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "decision-policy",
      "from": "decision",
      "to": "policy",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "policy-action",
      "from": "policy",
      "to": "action",
      "role": "main",
      "variant": "emphasis",
      "label": "ALLOW"
    },
    {
      "id": "action-obs",
      "from": "action",
      "to": "obs",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "obs-update",
      "from": "obs",
      "to": "update",
      "role": "main",
      "label": "证据"
    },
    {
      "id": "update-evaluate",
      "from": "update",
      "to": "evaluate",
      "role": "main"
    },
    {
      "id": "eval-cont",
      "from": "evaluate",
      "to": "cont",
      "label": "继续"
    },
    {
      "id": "eval-recover",
      "from": "evaluate",
      "to": "recover",
      "label": "需恢复"
    },
    {
      "id": "eval-ask",
      "from": "evaluate",
      "to": "ask",
      "label": "需用户"
    },
    {
      "id": "eval-finish",
      "from": "evaluate",
      "to": "finish",
      "label": "目标达成",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "cont-decision",
      "from": "cont",
      "to": "decision",
      "role": "return",
      "variant": "dashed",
      "label": "下一次迭代"
    },
    {
      "id": "recover-action",
      "from": "recover",
      "to": "action",
      "role": "return",
      "variant": "dashed",
      "label": "重试 / 替代",
      "channelX": 760
    },
    {
      "id": "policy-ask",
      "from": "policy",
      "to": "ask",
      "role": "error",
      "variant": "security",
      "label": "DENY"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主循环",
      "items": [
        "Goal → 上下文编译 → 决策 → 策略 → 执行 → 观察 → 更新 → 评估",
        "状态与世界模型由运行时持有，LLM 只提议决策"
      ]
    },
    {
      "dot": "rose",
      "title": "策略在模型之外",
      "items": [
        "Policy Check 以确定性代码执行 ALLOW / CONFIRM / DENY",
        "DENY 不再回到模型，直接进入 Ask User 或终止"
      ]
    },
    {
      "dot": "emerald",
      "title": "评估决定出口",
      "items": [
        "工具成功 ≠ 任务成功，Evaluation 强制验证后才可 Finish",
        "Continue 支持动态任务扩展，Recover 回到执行而非盲目重试"
      ]
    }
  ]
}